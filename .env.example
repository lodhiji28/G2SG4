# ---------------------------------------------------------------------------
# Rank Mitra — environment template.  Copy to `.env.local` and fill in.
#   cp .env.example .env.local
# NOTHING here is required to start: with zero config the app runs on a local
# SQLite file and prints e-mails to the console.
# ---------------------------------------------------------------------------

# ---- Exam identity ---------------------------------------------------------
# One row per (exam_id, roll_number). Change this only if you fork the site for
# another exam, and bump it before a new exam cycle.
EXAM_ID=mpesb-g2sg4-2026

# ---- Database ---------------------------------------------------------------
# auto  = use D1 binding if present, else DATABASE_URL, else local SQLite file
# sqlite    -> local file (dev)                 : node:sqlite, no install needed
# postgres  -> Supabase / Neon / Render Postgres : needs `npm i pg` (already here)
# d1        -> Cloudflare D1                     : set by worker/ + wrangler.toml
DB_DRIVER=auto

# Postgres connection string.  Neon: "Neon connection string (pooled)".
# Supabase: Dashboard -> Project Settings -> Database -> Connection string
#           use the *session* pooler for a free-tier app (fewer connections).
# DATABASE_URL=postgresql://user:pass@ep-x.us-east-2.aws.neon.tech/dbname?sslmode=require
DATABASE_URL=

# Local dev database path (relative to the project root)
SQLITE_PATH=.data/rank-mitra.sqlite

# Cloudflare D1 binding name (must match wrangler.toml)
D1_BINDING=RANK_MITRA_DB

# ---- API behaviour ----------------------------------------------------------
# 30-minute data cache, matching the on-screen "डेटा हर 30 मिनट में ताज़ा" rule.
# Browsers + CDN revalidate with an ETag, so a cache hit costs 0 bytes.
CACHE_MAX_AGE=3600
# Anti-spam: submissions per IP per hour
SUBMIT_RATE_PER_HOUR=20
# Comma separated origins allowed to call the API. `*` = any origin (public site)
# If the site lives on Netlify and the API on Cloudflare, list the Netlify host:
#   ALLOWED_ORIGINS=https://rank-mitra.netlify.app,https://www.rank-mitra.netlify.app
ALLOWED_ORIGINS=*

# Privacy default: the uploaded answer key is READ, never STORED. Only name,
# roll number, shift/date and correct/wrong/attempted/unattempted/score are kept.
# Set to 1 only if you also want the 200-character per-question pattern in the DB.
STORE_QUESTION_PATTERN=0

# ---- Admin panel ------------------------------------------------------------
# Leave ADMIN_PASSWORD empty and the /admin tab + all admin endpoints stay off.
ADMIN_PASSWORD=
# Long random string used to sign admin session tokens. Generate:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=
ADMIN_TOKEN_TTL_HOURS=12

# ---- E-mail (free tiers only) ----------------------------------------------
# console  -> prints to server log (default, safe)
# brevo    -> 300 e-mails/day free            (best free volume, REST API)
# resend   -> 3,000/month, 100/day free       (REST API)
# smtp     -> any SMTP relay (Brevo SMTP, Gmail app password, Zoho…)
EMAIL_PROVIDER=console
EMAIL_FROM="Rank Mitra <alerts@yourdomain.in>"
# Optional: notify yourself about every new submission
ADMIN_EMAIL=
# Hard daily cap so a free quota can never be burned by an accident
EMAIL_DAILY_LIMIT=200

BREVO_API_KEY=
RESEND_API_KEY=

# Only needed for EMAIL_PROVIDER=smtp
SMTP_URL=
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_SECURE=0
SMTP_USER=
SMTP_PASS=

# ---- Front-end build (Netlify / Vercel / Cloudflare Pages) ------------------
# Same-origin is the default: set this only when the API lives on another host.
#   VITE_API_BASE=https://rank-mitra-api.<you>.workers.dev/api
#   VITE_API_TIMEOUT=10000
# Leave VITE_API_DISABLED=1 to ship a browser-only build with no network calls.
VITE_API_DISABLED=0

# ---- Misc -------------------------------------------------------------------
# Public base URL of the deployed site (used in e-mails/links)
SITE_URL=
PORT=8787
SERVE_STATIC=1
LOG_LEVEL=info

# AI Studio leftovers (unused by this app; safe to ignore)
GEMINI_API_KEY=
APP_URL=

# ── Supabase / Postgres ────────────────────────────────────────────────────
# ALWAYS the session-pooler host (aws-0-<region>.pooler.supabase.com:5432).
# The direct endpoint db.<ref>.supabase.co is IPv6-only → serverless hangs.
# Schema/migrations run automatically at boot; no manual SQL required.
# DB_DRIVER=postgres
# DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-ap-south-1.pooler.supabase.com:5432/postgres?sslmode=require
